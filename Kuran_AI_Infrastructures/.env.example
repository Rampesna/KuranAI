# PostgreSQL
POSTGRES_DB=kuranai_pgsql
POSTGRES_USER=kuranai_user
POSTGRES_PASSWORD=replace_with_a_long_random_password
POSTGRES_PORT=9301

# Redis
REDIS_PASSWORD=replace_with_a_long_random_password
REDIS_PORT=9302

# Gateway
GATEWAY_PORT=9300
JWT_ACCESS_SECRET=replace_with_at_least_32_random_characters
JWT_REFRESH_SECRET=replace_with_at_least_32_random_characters

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CLIENT_IDS=ios_client_id.apps.googleusercontent.com,web_client_id.apps.googleusercontent.com
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
APPLE_IAP_SHARED_SECRET=
APPLE_BUNDLE_ID=talhacan.KuranAIChat
APPLE_CLIENT_IDS=talhacan.KuranAIChat,com.talhacan.kuranai.web
GOOGLE_PLAY_PACKAGE_NAME=com.talhacan.kuranai
GOOGLE_PLAY_CREDENTIALS_PATH=/var/run/secrets/google-play/service-account.json
GOOGLE_PLAY_ALLOW_TEST=true
# Local path used by deploy-kubernetes.sh to create the Kubernetes secret.
GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=

# Public endpoints
CORS_ORIGINS=https://kuranai.talhacan.com
PUBLIC_API_URL=https://kuranai-api.talhacan.com
VITE_API_BASE=https://kuranai-api.talhacan.com
VITE_GOOGLE_CLIENT_ID=
VITE_APPLE_CLIENT_ID=com.talhacan.kuranai.web
VITE_APPLE_REDIRECT_URI=https://kuranai.talhacan.com/auth/apple/callback
WEBAUTHN_RP_ID=kuranai.talhacan.com
WEBAUTHN_RP_NAME=Kuran AI
WEBAUTHN_RP_ORIGINS=https://kuranai.talhacan.com,android:apk-key-hash:avWvUoG9uWaFLs7oJC8mnbX-wsPsyKwlJcZjUechgiI,android:apk-key-hash:FYBZ-DeOeuM2WhoWpYSJoMnu-dJi7x97ldOvCToDLFs

# Supply only at secret-creation time; never commit a live value.
OPENAI_API_KEY=
